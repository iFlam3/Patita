# =============================================================================
# Patita — variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores. NO contiene credenciales
# reales. Nunca subas tu .env a un repositorio.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="Patita"
# development | production
APP_ENV=development
# En producción debe ser false (oculta detalles de errores).
APP_DEBUG=true
# URL pública sin barra final. Se usa en los enlaces de correo.
APP_URL=http://127.0.0.1:8080
# true muestra una franja que avisa que precios, stock y marcas son de prueba.
APP_DEMO_NOTICE=false
# Datos de contacto públicos (páginas Contacto y Términos). Teléfono opcional.
CONTACT_EMAIL=hola@example.test
CONTACT_PHONE=

# --- País, idioma y moneda ---------------------------------------------------
# País Venezuela, precios en dólares (USD). APP_LOCALE=es-US muestra $1,234.50
# (es-VE mostraría "USD 1.234,50"). Cambia los valores
# juntos si adaptas la tienda a otro país (p. ej. CO / es-CO / COP).
APP_COUNTRY=VE
APP_LOCALE=es-US
APP_CURRENCY=USD
APP_TIMEZONE=America/Caracas
# Países a los que se permite enviar: códigos ISO separados por coma, o * para todos.
SHIPPING_COUNTRIES=*

# --- Base de datos (MySQL 8+ o MariaDB 10.4+) -------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=patita
DB_USERNAME=patita
DB_PASSWORD=cambia-esta-clave

# --- Sesión ------------------------------------------------------------------
SESSION_NAME=patita_session
# auto = cookie Secure solo si la petición llega por HTTPS; true | false
SESSION_SECURE_COOKIE=auto
# Minutos de inactividad antes de cerrar la sesión.
SESSION_IDLE_MINUTES=120

# --- Envíos y pagos (modalidad demostrativa, sin cobros reales) --------------
# Costo fijo de envío en la moneda de la tienda.
SHIPPING_FLAT_RATE=5.99
# Subtotal a partir del cual el envío es gratis. 0 = nunca gratis.
SHIPPING_FREE_FROM=50.00
# Métodos habilitados: bank_transfer, cash_on_delivery (separados por coma).
PAYMENT_METHODS=bank_transfer,cash_on_delivery
# Datos que se muestran al elegir transferencia. Usa datos reales solo en producción.
BANK_TRANSFER_DETAILS="Banco de ejemplo - Cuenta 0000000000 - Titular: Patita (demo)"
# Cantidad máxima de unidades de un mismo producto por pedido.
MAX_QTY_PER_ITEM=20

# --- Correo ------------------------------------------------------------------
# log  = guarda cada correo como archivo .eml en storage/mail (solo desarrollo)
# smtp = envía por SMTP (cliente nativo, sin dependencias). Gmail: smtp.gmail.com,
#        puerto 587, tls, usuario = tu correo y una contraseña de aplicación.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="Patita"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (STARTTLS) | ssl | none
SMTP_ENCRYPTION=tls

# --- Seguridad de autenticación ---------------------------------------------
# Intentos fallidos permitidos por correo+IP dentro de la ventana.
LOGIN_MAX_ATTEMPTS=5
# Intentos fallidos permitidos por IP (cualquier correo) dentro de la ventana.
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_DECAY_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
# Solicitudes de recuperación por correo+IP dentro de la ventana de LOGIN_DECAY_MINUTES.
PASSWORD_RESET_MAX_REQUESTS=3

# --- Importador (CLI) --------------------------------------------------------
# Fuentes web habilitadas, separadas por coma (petstore_direct, petsmart).
# Déjalo VACÍO hasta contar con autorización escrita de la fuente: sus
# términos restringen la reutilización comercial del contenido.
IMPORT_ALLOWED_SOURCES=
# Identifica al cliente HTTP. Pon una URL y un correo de contacto reales.
IMPORT_USER_AGENT="PatitaCatalogBot/1.0 (+https://example.test/bot; contacto@example.test)"
IMPORT_DELAY_SECONDS=3
IMPORT_TIMEOUT_SECONDS=15
IMPORT_MAX_RETRIES=2
IMPORT_CACHE_TTL_HOURS=24
# false = no copia descripciones de la fuente (se deja un texto pendiente de redactar).
IMPORT_COPY_DESCRIPTIONS=false
# false = usa ilustraciones locales en lugar de las imágenes de la fuente.
IMPORT_USE_REMOTE_IMAGES=false
