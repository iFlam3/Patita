# Solo imágenes subidas por el panel. Nunca se ejecutan scripts aquí.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py
<FilesMatch "\.(?i:php\d?|phtml|phar|cgi|pl|py|sh|html?|svg)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
